{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/security/layout,_N_T_/security/dashboard/layout,_N_T_/security/dashboard/page,_N_T_/security/dashboard"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/security/dashboard/__PAGE__",
    "/security/dashboard",
    "/security",
    "/_index",
    "/_head"
  ]
}