{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/labs",
      "destination": "/scuben-ai-labs",
      "statusCode": 308,
      "regex": "^(?!/_next)/labs(?:/)?$"
    },
    {
      "source": "/labs/:path*",
      "destination": "/scuben-ai-labs/:path*",
      "statusCode": 308,
      "regex": "^(?!/_next)/labs(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
